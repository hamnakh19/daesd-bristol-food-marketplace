    <bpmn:sequenceFlow id="Flow_1k6jpxq" name="No" sourceRef="Gateway_0xpvnv3" targetRef="Gateway_06bvwzc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(date(availabilityStartDate) &lt;= today() and today() &lt;= date(availabilityEndDate))</bpmn:conditionExpression>
